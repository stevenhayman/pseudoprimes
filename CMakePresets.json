{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw",
      "displayName": "Windows MinGW (MSYS2 GCC)",
      "description": "GCC from MSYS2 mingw64, GMP from pacman",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/mingw",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/mingw32-make.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/mingw64",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-gcc",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS Clang",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/macos-clang",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mingw", "configurePreset": "mingw" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "macos-clang", "configurePreset": "macos-clang" }
  ],
  "testPresets": [
    { "name": "mingw", "configurePreset": "mingw", "output": { "outputOnFailure": true } },
    { "name": "linux-gcc", "configurePreset": "linux-gcc", "output": { "outputOnFailure": true } },
    { "name": "macos-clang", "configurePreset": "macos-clang", "output": { "outputOnFailure": true } }
  ]
}
